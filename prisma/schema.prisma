// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum EventType {
  TASYAKURAN
  BEDAH_BUKU
}

model Event {
  id        String    @id @default(cuid())
  name      String
  type      EventType
  startsAt  DateTime
  location  String
  mapsQuery String?
  quota     Int       @default(100)
  // Konten khusus per jenis acara (judul buku, pembicara, rundown, dll.)
  details   Json?
  createdAt DateTime  @default(now())
  guests    Guest[]
}

model Guest {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  category    String?
  phone       String?
  invited     Boolean    @default(false)
  attendance  Attendance @default(PENDING)
  guestCount  Int?
  message     String?
  // Data RSVP tambahan per jenis acara (mis. jumlah pesanan buku, pertanyaan)
  extra       Json?
  respondedAt DateTime?
  createdAt   DateTime   @default(now())

  eventId     String
  event       Event      @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

enum Attendance {
  PENDING
  HADIR
  TIDAK_HADIR
}

// ---------------------------------------------------------------------------
// Pendaftaran terbuka (bukan undangan per tamu), mis. KAI - SASNU PEDULI
// Pemeriksaan USG Abdomen. Satu link untuk semua orang, tiap orang mengisi sendiri.
// ---------------------------------------------------------------------------
model RegistrationEvent {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  startsAt    DateTime
  location    String
  quota       Int          @default(150)
  isOpen      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  registrants Registrant[]
}

model Registrant {
  id          String            @id @default(cuid())
  eventId     String
  event       RegistrationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  // Sudah dirapikan (tanpa spasi, huruf besar). "-" = bukan pensiunan KAI.
  memberNo    String
  institution String
  // Tanda tangan: data URL PNG (kecil, ±5-15 KB)
  signature   String
  // Kunci anti-dobel: "NO:<no keanggotaan>" atau, bila "-", "NM:<nama>|<instansi>"
  uniqueKey   String
  attended    Boolean           @default(false)
  attendedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@unique([eventId, uniqueKey])
  @@index([eventId, createdAt])
}
